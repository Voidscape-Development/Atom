// Atom - Particle system plugin for OBS Studio
// Draws atom sprites as textured quads modulated by a per-vertex colour.

uniform float4x4 ViewProj;
uniform texture2d image;

sampler_state atomSampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertInOut {
	float4 pos   : POSITION;
	float2 uv    : TEXCOORD0;
	float4 color : COLOR;
};

VertInOut VSAtom(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv = vert_in.uv;
	vert_out.color = vert_in.color;
	return vert_out;
}

float4 PSAtom(VertInOut vert_in) : TARGET
{
	float4 texel = image.Sample(atomSampler, vert_in.uv);
	return texel * vert_in.color;
}

technique Draw
{
	pass
	{
		vertex_shader = VSAtom(vert_in);
		pixel_shader  = PSAtom(vert_in);
	}
}
